<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.nima.streetracing"
    android:versionCode="10"
    android:versionName="1.0.0">
    <uses-sdk android:minSdkVersion="10" android:targetSdkVersion="10" />
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <supports-screens android:smallScreens="true" android:normalScreens="true"
        android:largeScreens="true" android:anyDensity="true" />
    <application android:label="Nima Street Racing" android:icon="@drawable/ic_launcher"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
        android:allowBackup="false">
        <activity android:name=".MainActivity" android:screenOrientation="landscape"
            android:configChanges="orientation|keyboardHidden"
            android:label="Nima Street Racing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
